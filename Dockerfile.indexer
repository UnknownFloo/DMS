# ############################
# Build the OCR-result indexer.
# ############################
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Paperless.Indexer/Paperless.Indexer.csproj
RUN dotnet publish src/Paperless.Indexer/Paperless.Indexer.csproj -c Release -o /app/publish --no-restore

# ############################
# Run the published indexer worker.
# ############################
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Paperless.Indexer.dll"]
